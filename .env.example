# Neon Postgres.
#
# DATABASE_URL must be the POOLED connection (its host contains "-pooler"):
# neon-http opens a connection per query, so the app needs the pooler.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The direct (unpooled) connection to the same database. Optional locally, but
# migrations use it when present — DDL runs in a transaction and takes advisory
# locks that a transaction pooler can drop. Vercel's Neon integration sets both.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# `npx auth secret` generates one.
AUTH_SECRET=""

# Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
# Authorised redirect URIs (add every origin you sign in from):
#   http://localhost:3000/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Production only. Vercel preview deployments infer the host automatically.
# AUTH_URL="https://your-app.vercel.app"
